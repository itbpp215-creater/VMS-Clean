# ========================================================================
# BPP-VMS Clean Machine Environment Template
# ========================================================================
# แม่แบบค่าคอนฟิกสำหรับเครื่องใหม่ ปราศจากข้อมูลและรหัสผ่านของ ตชด.215
# นำไปคัดลอกเป็น .env ตอนเริ่มรันระบบ

# ------------------------------------------------------------------------
# 1. การยืนยันตัวตนและความปลอดภัยของระบบ
# ------------------------------------------------------------------------
AUTH_COOKIE_SECURE=true
COMPOSE_PROJECT_NAME=bpp-vms
STORAGE_MIN_FREE_PERCENT=15
BPP_FEDERATION_ALLOW_CIDR=127.0.0.1/32
WATCHLIST_ALLOWED_ORIGINS=

# ความปลอดภัยภายในระบบ (สคริปต์ติดตั้งจะสุ่มให้อัตโนมัติ)
AUTH_AUDIT_SHARED_SECRET=
WATCHLIST_PROXY_SHARED_SECRET=
WATCHLIST_FEDERATION_SHARED_SECRET=
WATCHLIST_SERVICE_SHARED_SECRET=

# ------------------------------------------------------------------------
# 2. ข้อมูลกล้องเริ่มต้น (Default Camera Credentials)
# ------------------------------------------------------------------------
FRIGATE_DVR_USER=admin
FRIGATE_DVR_PASS=admin1234
FRIGATE_PRASAT_USER=admin
FRIGATE_PRASAT_PASS=admin1234
FRIGATE_CAM11_USER=
FRIGATE_CAM11_PASS=

# ------------------------------------------------------------------------
# 3. Thai License Plate Recognition (LPR) & AI Detection
# ------------------------------------------------------------------------
LPR_CAMERAS=cam_sample
LPR_ALERT_LOCATION=Main Checkpoint
LPR_ALERT_COOLDOWN=30
LPR_SUSPECT_PLATES=
LPR_SUPERADMIN_USERNAME=admin

# ------------------------------------------------------------------------
# 4. Google Gemini AI & Telegram Bot (เสริม - ใส่เมื่อต้องการใช้งาน)
# ------------------------------------------------------------------------
# ขอคีย์ฟรีได้ที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ขอคีย์บอทฟรีได้จากแอป Telegram ผ่าน @BotFather และหาไอดีผ่าน @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LPR_TELEGRAM_BOT_TOKEN=
LPR_TELEGRAM_CHAT_ID=

DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
LPR_DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------
# 5. NAS Storage & Network Backup (เสริม - ไม่บังคับ)
# ------------------------------------------------------------------------
NAS_STORAGE_PATH=/data/nas-storage
NAS_HOST=
NAS_SHARE=
NAS_USERNAME=
NAS_PASSWORD=
NAS_SYNC_ENABLED=false
NAS_SYNC_DEBOUNCE_SEC=8
NAS_VIDEO_ARCHIVE_ENABLED=false
NAS_VIDEO_ARCHIVE_INTERVAL_MIN=15
BPP_ARCHIVE_DIR=./storage/lpr-archive
BPP_ARCHIVE_CROPS_DIR=./storage/lpr-archive

# ------------------------------------------------------------------------
# 6. การเข้าถึงระยะไกล (Remote Access - ออฟชั่นเสริม)
# ------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=none_local_only
PUBLIC_DOMAIN=
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=vms-node
